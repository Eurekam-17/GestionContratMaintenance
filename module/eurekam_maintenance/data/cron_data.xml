<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Daily cron: switch contracts to 'expiring' (D-90) or 'expired' (D+0)
            based on date_end and send the related emails.

            Code executed:
                model._cron_check_expiring_contracts()
        -->
        <record id="cron_check_expiring_contracts" model="ir.cron">
            <field name="name">Eurekam Maintenance: check expiring contracts</field>
            <field name="model_id" ref="model_eurekam_maintenance_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expiring_contracts()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!--
            Weekly cron: raise an activity on each contract year that still
            has no quotation attached.

            Code executed:
                model._cron_check_years_to_order()

            SHIPPED INACTIVE ON PURPOSE. The alert reads the link between a
            contract year and a customer order, and that link is barely
            populated yet: production carries roughly 970 customer orders of
            which only a handful point at a contract, because the orders
            predate the module. Switched on as it stands, the first run would
            raise an activity on very nearly every live contract, all of them
            wrong, since the quotation usually exists and is simply not
            attached. The team would learn to ignore the alert inside a
            fortnight, and the feature would be dead on arrival.

            Enable it (Settings > Technical > Scheduled Actions) once the
            existing orders have been attached to their contracts.
        -->
        <record id="cron_check_years_to_order" model="ir.cron">
            <field name="name">Eurekam Maintenance: contract years still to be quoted</field>
            <field name="model_id" ref="model_eurekam_maintenance_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_years_to_order()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="False"/>
        </record>

        <!--
            Daily cron: the period that falls due, one at a time.

            Code executed:
                model._cron_check_periods_due()

            Livre ACTIF, contrairement au precedent. Il ne regarde que les
            lignes portant des bornes de periode, c'est-a-dire les devis que
            ce module emet lui-meme. Les commandes historiques rattachees
            apres coup n'en ont pas, a dessein : elles ne sont jamais
            redecoupees. Le premier passage ne trouve donc rien, et le suivi
            grandit au rythme des devis reellement emis. Aucun risque de
            crier au loup sur l'existant.
        -->
        <record id="cron_check_periods_due" model="ir.cron">
            <field name="name">Eurekam Maintenance: maintenance period falling due</field>
            <field name="model_id" ref="model_eurekam_maintenance_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_periods_due()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
