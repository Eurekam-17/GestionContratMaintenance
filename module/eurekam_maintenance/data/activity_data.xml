<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Activity type raised by _cron_check_years_to_order on a contract
            year that still has no quotation attached.

            noupdate="1": the sales team may rename it or change its delay,
            and a module update must not undo that.
        -->
        <record id="activity_type_year_to_order" model="mail.activity.type">
            <field name="name">Devis annuel à émettre</field>
            <field name="summary">Année de contrat sans devis rattaché</field>
            <field name="icon">fa-file-text-o</field>
            <field name="res_model">eurekam.maintenance.contract</field>
            <field name="delay_count">0</field>
            <field name="sequence">30</field>
        </record>

        <!--
            Activity raised by _cron_check_periods_due on the customer order
            whose period falls due: the quotation to send, or the period to
            invoice. Carried by the ORDER and not the contract, so that a
            quarterly contract can hold one reminder per period at a time
            instead of a single one hiding the next.
        -->
        <record id="activity_type_period_due" model="mail.activity.type">
            <field name="name">Période de maintenance échue</field>
            <field name="summary">Devis à envoyer, ou période à facturer</field>
            <field name="icon">fa-calendar-check-o</field>
            <field name="res_model">sale.order</field>
            <field name="delay_count">0</field>
            <field name="sequence">31</field>
        </record>

    </data>
</odoo>
