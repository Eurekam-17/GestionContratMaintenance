<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Initial generations. Editable list: the team can add GEN3 and
             beyond from Maintenance > Configuration > Generations, without a
             code change. Codes mirror the former `gen` selection keys so the
             migration can map the existing contracts. -->
        <record id="gen_gen1" model="eurekam.product.generation">
            <field name="name">GEN1</field>
            <field name="code">gen1</field>
            <field name="sequence">10</field>
        </record>
        <record id="gen_gen2" model="eurekam.product.generation">
            <field name="name">GEN2</field>
            <field name="code">gen2</field>
            <field name="sequence">20</field>
        </record>
        <record id="gen_upgrade_gen2" model="eurekam.product.generation">
            <field name="name">Upgrade GEN2</field>
            <field name="code">upgrade_gen2</field>
            <field name="sequence">30</field>
        </record>

    </data>
</odoo>
