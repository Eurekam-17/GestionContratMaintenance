<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Module category to group the Maintenance groups -->
        <record id="module_category_maintenance" model="ir.module.category">
            <field name="name">Eurekam Maintenance</field>
            <field name="description">Eurekam maintenance contracts tracking.</field>
            <field name="sequence">20</field>
        </record>

        <!-- User group: views/edits their contracts -->
        <record id="group_maintenance_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_maintenance"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Manager group: + configuration + deletion + sees everything -->
        <record id="group_maintenance_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_maintenance"/>
            <field name="implied_ids" eval="[(4, ref('group_maintenance_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Record rule: multi-company isolation for standard users -->
        <record id="rule_maintenance_contract_company" model="ir.rule">
            <field name="name">Maintenance contracts: company isolation</field>
            <field name="model_id" ref="model_eurekam_maintenance_contract"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_maintenance_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Record rule: multi-company isolation on the yearly lines
             (company_id related stored from the contract). Required because the
             lines are accessible directly via the "Yearly Lines" menu, without
             going through the parent contract. -->
        <record id="rule_maintenance_contract_line_company" model="ir.rule">
            <field name="name">Maintenance lines: company isolation</field>
            <field name="model_id" ref="model_eurekam_maintenance_contract_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_maintenance_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
