<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================== -->
    <!-- Extension of the res.partner form view                          -->
    <!-- Adds an "Eurekam Maintenance" tab + a smart button.             -->
    <!-- ============================================================== -->
    <record id="view_res_partner_form_maintenance" model="ir.ui.view">
        <field name="name">res.partner.form.maintenance</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Fields consumed by the 'invisible' expressions of the smart
                 button (below) and of the banners (declared just BEFORE the
                 button box). In Odoo 18, a field referenced in an
                 invisible/readonly/required expression must be declared BEFORE
                 its first use in the view: a visible occurrence further down
                 (e.g. is_maintenance_establishment near the tags) is NOT enough
                 anymore — it was in Odoo 17, it no longer is. We therefore
                 declare here, invisible, the two fields used by top-of-form
                 modifiers: maintenance_status and is_maintenance_establishment.
                 The *_contract_count fields are only displayed (never used in a
                 modifier expression), so they don't need a copy here. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="maintenance_status" invisible="1"/>
                <field name="is_maintenance_establishment" invisible="1"/>
                <button name="action_view_maintenance_contracts" type="object"
                        class="oe_stat_button" icon="fa-wrench"
                        invisible="not is_maintenance_establishment">
                    <field name="maintenance_contract_count" widget="statinfo"
                           string="Contracts"/>
                </button>
            </xpath>

            <!-- MAINTENANCE BANNERS: colored banners by status, visible to the
                 WHOLE team (notably support) opening a customer form. -->
            <xpath expr="//div[@name='button_box']" position="before">
                <div class="alert alert-success o_form_full_width mt-2 mb-3"
                     role="alert"
                     invisible="maintenance_status != 'active'">
                    <i class="fa fa-check-circle me-2" title="Maintenance active" role="img"/>
                    <strong>Maintenance ACTIVE</strong>
                    <span class="ms-2">
                        (<field name="active_maintenance_contract_count" readonly="1" nolabel="1" class="oe_inline"/> active contract(s))
                    </span>
                </div>
                <div class="alert alert-warning o_form_full_width mt-2 mb-3"
                     role="alert"
                     invisible="maintenance_status != 'expiring'">
                    <i class="fa fa-exclamation-triangle me-2" title="Maintenance expiring soon" role="img"/>
                    <strong>Maintenance EXPIRING SOON</strong>
                    <span class="ms-2">
                        (<field name="expiring_maintenance_contract_count" readonly="1" nolabel="1" class="oe_inline"/> contract(s) to renew)
                    </span>
                </div>
                <div class="alert alert-danger o_form_full_width mt-2 mb-3"
                     role="alert"
                     invisible="maintenance_status != 'expired'">
                    <i class="fa fa-times-circle me-2" title="Maintenance expired" role="img"/>
                    <strong>Maintenance EXPIRED</strong>
                    <span class="ms-2">
                        (<field name="expired_maintenance_contract_count" readonly="1" nolabel="1" class="oe_inline"/> expired contract(s))
                    </span>
                </div>
                <div class="alert alert-info o_form_full_width mt-2 mb-3"
                     role="alert"
                     invisible="maintenance_status != 'client_no_contract'">
                    <i class="fa fa-handshake-o me-2" title="Customer without maintenance contract" role="img"/>
                    <strong>Customer WITHOUT maintenance contract</strong>
                    <span class="ms-2">
                        — at least one customer order recorded, but no maintenance
                        contract. <em class="text-muted">Potential to convert.</em>
                    </span>
                </div>
                <div class="alert alert-secondary o_form_full_width mt-2 mb-3"
                     role="alert"
                     invisible="not is_maintenance_establishment or maintenance_status != 'none'">
                    <i class="fa fa-info-circle me-2" title="No commercial relationship" role="img"/>
                    <strong>No commercial relationship</strong>
                    <span class="ms-2 text-muted">
                        — no maintenance contract and no customer order recorded.
                    </span>
                </div>
            </xpath>

            <!-- Flag in the form header (next to the name) -->
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_maintenance_establishment"/>
            </xpath>

            <!-- Eurekam Maintenance tab in the notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Eurekam Maintenance" name="maintenance_eurekam"
                      invisible="not is_maintenance_establishment">
                    <group>
                        <group string="Location">
                            <field name="department_number"/>
                        </group>
                        <group string="Classification">
                            <!-- Establishment type (CH, CHU, CLCC...): use the
                                 standard Odoo tags (category_id field) already
                                 shown at the top of the partner form. -->
                            <field name="establishment_status"/>
                            <field name="central_purchasing_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Installed Equipment">
                            <field name="nb_workstations"/>
                            <!-- Product version (GEN1, GEN2): use the standard
                                 Odoo tags (category_id field). -->
                            <field name="module_status_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                            <field name="special_equipment_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                        </group>
                        <group string="Maintenance">
                            <field name="active_maintenance_contract_count"
                                   readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ============================================================== -->
    <!-- Extension of the res.partner list view (decoration)             -->
    <!-- ============================================================== -->
    <record id="view_res_partner_list_maintenance" model="ir.ui.view">
        <field name="name">res.partner.list.maintenance</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='complete_name']" position="after">
                <field name="is_maintenance_establishment" optional="hide"/>
                <field name="department_number" optional="hide"/>
                <field name="maintenance_contract_count" optional="hide"/>
                <field name="maintenance_status" optional="hide"
                       widget="badge"
                       decoration-success="maintenance_status == 'active'"
                       decoration-warning="maintenance_status == 'expiring'"
                       decoration-danger="maintenance_status == 'expired'"
                       decoration-info="maintenance_status == 'client_no_contract'"
                       decoration-muted="maintenance_status == 'none'"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- Extension of the res.partner search view                        -->
    <!-- ============================================================== -->
    <record id="view_res_partner_search_maintenance" model="ir.ui.view">
        <field name="name">res.partner.search.maintenance</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='name']" position="after">
                <field name="department_number"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Maintenance Establishments"
                        name="filter_maintenance_establishments"
                        domain="[('is_maintenance_establishment','=',True)]"/>
                <filter string="Customers Without Maintenance Contract"
                        name="filter_clients_without_contract"
                        domain="[('sale_order_ids','!=',False), ('maintenance_contract_ids','=',False)]"/>
                <filter string="Companies Only"
                        name="filter_companies_only"
                        domain="[('is_company','=',True)]"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- Action: filtered list of maintenance establishments             -->
    <!-- ============================================================== -->
    <record id="action_maintenance_establishment" model="ir.actions.act_window">
        <field name="name">Establishments</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_maintenance_establishment', '=', True)]</field>
        <field name="context">
            {
                'default_is_maintenance_establishment': True,
                'default_is_company': True,
                'search_default_filter_maintenance_establishments': 1,
            }
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Reference your first customer establishment
            </p>
            <p>
                Maintenance establishments gather the hospitals, clinics and
                distributors for which you track Drugcam contracts.
            </p>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- Server action: create a maintenance contract from a selected     -->
    <!-- partner (shows in the Action menu of res.partner views, for      -->
    <!-- maintenance users only).                                         -->
    <!-- ============================================================== -->
    <record id="action_server_create_contract_from_partner" model="ir.actions.server">
        <field name="name">Create Maintenance Contract</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('group_maintenance_user'))]"/>
        <field name="state">code</field>
        <field name="code">
if records:
    partner = records[0]
    # Creating a contract implies the partner becomes a maintenance
    # establishment (required by the domain of the contract partner_id field).
    # NB: we use write() and not attribute assignment, which is forbidden
    # (STORE_ATTR) in the safe_eval of server actions.
    if not partner.is_maintenance_establishment:
        partner.write({'is_maintenance_establishment': True})
    action = {
        'type': 'ir.actions.act_window',
        'name': 'New Maintenance Contract',
        'res_model': 'eurekam.maintenance.contract',
        'view_mode': 'form',
        'target': 'current',
        'context': {'default_partner_id': partner.id},
    }
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- Action: customers WITHOUT any maintenance contract               -->
    <!-- Commercial coverage tool: spot the customers (at least one        -->
    <!-- order) that still have no maintenance contract (neither active    -->
    <!-- nor expired), so that nobody is forgotten.                        -->
    <!-- create=False: the native "New" button would create a Contact,     -->
    <!-- which makes no sense here. To create a contract, select a         -->
    <!-- customer then Action menu > "Create Maintenance Contract".        -->
    <!-- ============================================================== -->
    <record id="action_maintenance_clients_without_contract" model="ir.actions.act_window">
        <field name="name">Customers Without Contract</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('sale_order_ids', '!=', False), ('maintenance_contract_ids', '=', False)]</field>
        <field name="search_view_id" ref="view_res_partner_search_maintenance"/>
        <field name="context">{'search_default_filter_companies_only': 1, 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No customer forgotten 🎉
            </p>
            <p>
                This list shows the <b>customers</b> (at least one sale order)
                that have <b>no maintenance contract</b> recorded — neither active
                nor expired.
            </p>
            <p>
                To create a contract: <b>select a customer</b> in the list, then
                menu <b>Action &gt; "Create Maintenance Contract"</b>.
                The contract form opens pre-filled with that customer.
            </p>
            <p>
                The "Companies Only" filter is active by default; remove it to
                also see individual contacts.
            </p>
        </field>
    </record>

</odoo>
