<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================== -->
    <!-- eurekam.billing.frequency                                       -->
    <!-- ============================================================== -->
    <record id="view_billing_frequency_list" model="ir.ui.view">
        <field name="name">eurekam.billing.frequency.list</field>
        <field name="model">eurekam.billing.frequency</field>
        <field name="arch" type="xml">
            <list string="Billing Frequencies" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description" optional="show"/>
                <field name="color" widget="color_picker"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_billing_frequency" model="ir.actions.act_window">
        <field name="name">Billing Frequencies</field>
        <field name="res_model">eurekam.billing.frequency</field>
        <field name="view_mode">list</field>
    </record>

