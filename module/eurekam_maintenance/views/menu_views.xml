<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root menu "Maintenance" -->
    <menuitem id="menu_root_maintenance"
              name="Maintenance"
              sequence="55"
              groups="group_maintenance_user"/>

    <!-- Submenu "Contracts" -->
    <menuitem id="menu_maintenance_contracts"
              name="Contracts"
              parent="menu_root_maintenance"
              action="action_maintenance_contract"
              sequence="10"/>

    <!-- Submenu "Yearly Lines": cross-year view -->
    <menuitem id="menu_maintenance_contract_lines"
              name="Yearly Lines"
              parent="menu_root_maintenance"
              action="action_maintenance_contract_line"
              sequence="20"/>

    <!-- Submenu "Establishments": partners flagged maintenance -->
    <menuitem id="menu_maintenance_establishments"
              name="Establishments"
              parent="menu_root_maintenance"
              action="action_maintenance_establishment"
              sequence="30"/>

    <!-- Submenu "Customers Without Contract": commercial coverage -->
    <menuitem id="menu_maintenance_clients_without_contract"
              name="Customers Without Contract"
              parent="menu_root_maintenance"
              action="action_maintenance_clients_without_contract"
              sequence="35"/>

    <!-- Submenu "Dashboard": pivot and graph -->
    <menuitem id="menu_maintenance_dashboard"
              name="Dashboard"
              parent="menu_root_maintenance"
              action="action_maintenance_dashboard"
              sequence="40"/>

    <!-- Submenu "Configuration" (manager only) -->
    <menuitem id="menu_maintenance_config"
              name="Configuration"
              parent="menu_root_maintenance"
              groups="group_maintenance_manager"
              sequence="90"/>

    <!-- Establishment types and product versions: use the standard
         res.partner.category tags (Contacts > Configuration > Contact Tags).
         No dedicated Maintenance submenu for them. -->
    <menuitem id="menu_config_module_status"
              name="Module Statuses"
              parent="menu_maintenance_config"
              action="action_module_status"
              sequence="30"/>
    <menuitem id="menu_config_special_equipment"
              name="Special Equipment"
              parent="menu_maintenance_config"
              action="action_special_equipment"
              sequence="40"/>
    <menuitem id="menu_config_billing_frequency"
              name="Billing Frequencies"
              parent="menu_maintenance_config"
              action="action_billing_frequency"
              sequence="50"/>
    <menuitem id="menu_config_module_billing"
              name="Module Billing"
              parent="menu_maintenance_config"
              action="action_module_billing"
              sequence="60"/>

</odoo>
