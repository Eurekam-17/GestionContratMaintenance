<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================== -->
    <!-- Form view                                                       -->
    <!-- ============================================================== -->
    <record id="view_maintenance_contract_form" model="ir.ui.view">
        <field name="name">eurekam.maintenance.contract.form</field>
        <field name="model">eurekam.maintenance.contract</field>
        <field name="arch" type="xml">
            <form string="Maintenance Contract">
                <header>
                    <button name="action_activate" type="object"
                            string="Activate" class="oe_highlight"
                            invisible="state not in ('draft','cancelled')"/>
                    <button name="action_generate_lines" type="object"
                            string="Generate Yearly Lines"
                            invisible="not date_start or not date_end"/>
                    <button name="action_open_renewal_wizard" type="object"
                            string="Renew" class="btn-primary"
                            invisible="state in ('draft','renewed','cancelled')"/>
                    <button name="action_open_create_order_wizard" type="object"
                            string="Create Customer Order" class="btn-primary"
                            invisible="state not in ('active','expiring') or not requires_customer_order"
                            help="Most common case: upon receipt of a customer purchase order, creates a sale.order with N lines according to the frequency (1 for Annual, 2 for Semi-annual, 4 for Quarterly). Each SO line can be invoiced independently."/>
                    <button name="action_create_invoices_for_contract" type="object"
                            string="Create Contract Invoices"
                            invisible="state not in ('active','expiring') or requires_customer_order"
                            help="Rare case: direct billing without a purchase order (private establishments). Generates the draft invoices covering the remaining contract duration according to the frequency."/>
                    <button name="action_recompute_state" type="object"
                            string="Recompute Status"
                            invisible="state in ('draft','cancelled','renewed')"
                            help="Re-evaluates the status (Active / Expiring Soon / Expired) based on the end date and today. Useful if the daily cron has not run (sandbox / staging case)."/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state in ('cancelled','renewed')"/>
                    <button name="action_draft" type="object"
                            string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,expiring,expired,renewed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="line_count" widget="statinfo"
                                   string="Yearly Lines"/>
                        </button>
                        <button name="action_view_renewed_from" type="object"
                                class="oe_stat_button" icon="fa-history"
                                invisible="not renewed_from_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Renewed From</span>
                            </div>
                        </button>
                        <button name="action_view_renewed_to" type="object"
                                class="oe_stat_button" icon="fa-arrow-right"
                                invisible="renewed_to_count == 0">
                            <field name="renewed_to_count" widget="statinfo"
                                   string="Renewed To"/>
                        </button>
                        <button name="action_view_sale_orders" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="sale_order_count == 0">
                            <field name="sale_order_count" widget="statinfo"
                                   string="Orders"/>
                        </button>
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo"
                                   string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="sequence_number" class="oe_edit_only"/>
                        <h1>
                            <field name="sequence_number" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="product_name"/>
                            <field name="commercial_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="country_id"/>
                        </group>
                        <group string="Characteristics">
                            <field name="gen"/>
                            <field name="market_type"/>
                            <field name="order_status"/>
                            <field name="nb_products"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dates &amp; Duration" name="dates">
                            <group>
                                <group>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="duration"/>
                                </group>
                                <group>
                                    <field name="days_to_expiry"/>
                                    <field name="is_expiring_soon"/>
                                </group>
                            </group>
                        </page>
                        <page string="Billing" name="billing">
                            <group>
                                <group string="Conditions">
                                    <field name="maintenance_amount"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="billing_level"/>
                                    <field name="syntec_revision"/>
                                    <field name="requires_customer_order"/>
                                </group>
                                <group string="Totals (computed)">
                                    <field name="total_contract_value"/>
                                    <field name="current_year_amount"/>
                                </group>
                            </group>
                            <group>
                                <group string="Billing Frequencies">
                                    <field name="billing_frequency_ids"
                                           widget="many2many_tags"
                                           options="{'color_field': 'color'}"
                                           nolabel="1"/>
                                </group>
                                <group string="Module Billing">
                                    <field name="module_billing_ids"
                                           widget="many2many_tags"
                                           options="{'color_field': 'color'}"
                                           nolabel="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Yearly Amounts" name="annual_lines">
                            <p class="text-muted">
                                Enter the yearly amount for each contract year.
                                The "Generate Yearly Lines" button in the header
                                pre-creates one line for each year between the start
                                and end dates.
                            </p>
                            <field name="line_ids">
                                <list editable="bottom"
                                      decoration-success="is_invoiced">
                                    <field name="year"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="invoice_count" optional="show"/>
                                    <field name="is_invoiced" widget="boolean_toggle" readonly="1"/>
                                    <field name="invoice_ids" widget="many2many_tags" optional="show"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="comment" placeholder="Free comments..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- List view                                                       -->
    <!-- ============================================================== -->
    <record id="view_maintenance_contract_list" model="ir.ui.view">
        <field name="name">eurekam.maintenance.contract.list</field>
        <field name="model">eurekam.maintenance.contract</field>
        <field name="arch" type="xml">
            <list string="Maintenance Contracts"
                  decoration-warning="is_expiring_soon"
                  decoration-danger="state == 'expired'"
                  decoration-muted="state in ('cancelled','renewed')">
                <field name="sequence_number"/>
                <field name="partner_id"/>
                <field name="product_id" optional="show"/>
                <field name="gen" optional="show"/>
                <field name="market_type" optional="show"/>
                <field name="order_status" optional="show"/>
                <field name="date_start" optional="hide"/>
                <field name="date_end"/>
                <field name="duration" optional="show"/>
                <field name="maintenance_amount" sum="Total"/>
                <field name="current_year_amount" optional="show" sum="Current year total"/>
                <field name="total_contract_value" optional="hide" sum="Contracts total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="syntec_revision" optional="hide"/>
                <field name="commercial_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'expiring'"
                       decoration-danger="state == 'expired'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state in ('cancelled','renewed')"/>
                <field name="is_expiring_soon" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- Kanban view                                                     -->
    <!-- ============================================================== -->
    <record id="view_maintenance_contract_kanban" model="ir.ui.view">
        <field name="name">eurekam.maintenance.contract.kanban</field>
        <field name="model">eurekam.maintenance.contract</field>
        <field name="arch" type="xml">
            <kanban default_group_by="order_status" class="o_kanban_small_column">
                <field name="state"/>
                <field name="is_expiring_soon"/>
                <field name="color"/>
                <field name="currency_id"/>
                <field name="current_year_amount"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <strong class="o_kanban_record_title">
                                        <field name="partner_id"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div><field name="product_id"/></div>
                                    <div>
                                        <strong>Current year:</strong>
                                        <field name="current_year_amount" widget="monetary"/>
                                    </div>
                                    <div t-if="record.date_end.raw_value">
                                        End: <field name="date_end"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'active': 'success', 'expiring': 'warning', 'expired': 'danger', 'draft': 'default'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- Search view                                                     -->
    <!-- ============================================================== -->
    <record id="view_maintenance_contract_search" model="ir.ui.view">
        <field name="name">eurekam.maintenance.contract.search</field>
        <field name="model">eurekam.maintenance.contract</field>
        <field name="arch" type="xml">
            <search string="Search Contracts">
                <field name="sequence_number"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="commercial_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state','=','draft')]"/>
                <filter string="Active" name="filter_active"
                        domain="[('state','=','active')]"/>
                <filter string="Expiring Soon" name="filter_expiring_soon"
                        domain="[('is_expiring_soon','=',True)]"/>
                <filter string="Expired" name="filter_expired"
                        domain="[('state','=','expired')]"/>
                <separator/>
                <filter string="My Contracts" name="filter_my_contracts"
                        domain="[('commercial_id','=',uid)]"/>
                <separator/>
                <filter string="With Syntec Revision" name="filter_syntec_yes"
                        domain="[('syntec_revision','=','yes')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state"
                            context="{'group_by':'state'}"/>
                    <filter string="Order Status" name="group_status"
                            context="{'group_by':'order_status'}"/>
                    <filter string="Generation" name="group_gen"
                            context="{'group_by':'gen'}"/>
                    <filter string="Market" name="group_market"
                            context="{'group_by':'market_type'}"/>
                    <filter string="Establishment" name="group_partner"
                            context="{'group_by':'partner_id'}"/>
                    <filter string="Salesperson" name="group_commercial"
                            context="{'group_by':'commercial_id'}"/>
                    <filter string="Syntec Revision" name="group_syntec"
                            context="{'group_by':'syntec_revision'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- Pivot view                                                      -->
    <!-- ============================================================== -->
    <record id="view_maintenance_contract_pivot" model="ir.ui.view">
        <field name="name">eurekam.maintenance.contract.pivot</field>
        <field name="model">eurekam.maintenance.contract</field>
        <field name="arch" type="xml">
            <pivot string="Contracts Analysis" sample="1">
                <field name="partner_id" type="row"/>
                <field name="gen" type="col"/>
                <field name="maintenance_amount" type="measure"/>
                <field name="total_contract_value" type="measure"/>
                <!-- current_year_amount is not a measure because the field is a
                     non-stored computed (store=False): impossible to aggregate
                     in SQL. To analyze the current year, use the pivot of the
                     "Yearly Lines" menu filtered on the year. -->
            </pivot>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- Graph view                                                      -->
    <!-- ============================================================== -->
    <record id="view_maintenance_contract_graph" model="ir.ui.view">
        <field name="name">eurekam.maintenance.contract.graph</field>
        <field name="model">eurekam.maintenance.contract</field>
        <field name="arch" type="xml">
            <graph string="Contracts by Market" type="bar" sample="1">
                <field name="market_type"/>
                <field name="maintenance_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- Calendar view                                                   -->
    <!-- ============================================================== -->
    <record id="view_maintenance_contract_calendar" model="ir.ui.view">
        <field name="name">eurekam.maintenance.contract.calendar</field>
        <field name="model">eurekam.maintenance.contract</field>
        <field name="arch" type="xml">
            <calendar string="Contracts"
                      date_start="date_start"
                      date_stop="date_end"
                      color="commercial_id"
                      mode="month">
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- Main action (with all available views)                          -->
    <!-- ============================================================== -->
    <record id="action_maintenance_contract" model="ir.actions.act_window">
        <field name="name">Maintenance Contracts</field>
        <field name="res_model">eurekam.maintenance.contract</field>
        <field name="view_mode">list,kanban,form,pivot,graph,calendar</field>
        <field name="search_view_id" ref="view_maintenance_contract_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first maintenance contract
            </p>
            <p>
                Track the full lifecycle of your Drugcam contracts:
                billing, renewal, expiry alerts.
            </p>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- "Dashboard" action: opens pivot/graph directly                  -->
    <!-- ============================================================== -->
    <record id="action_maintenance_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">eurekam.maintenance.contract</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="view_maintenance_contract_search"/>
        <field name="context">{
            'pivot_measures': ['maintenance_amount', 'total_contract_value'],
            'pivot_row_groupby': ['partner_id'],
            'pivot_column_groupby': ['gen'],
            'graph_measure': 'maintenance_amount',
            'graph_groupbys': ['market_type'],
        }</field>
    </record>

</odoo>
