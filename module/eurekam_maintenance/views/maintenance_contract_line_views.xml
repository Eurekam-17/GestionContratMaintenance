<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================== -->
    <!-- Yearly lines list view (cross-contract view)                    -->
    <!-- ============================================================== -->
    <record id="view_maintenance_contract_line_list" model="ir.ui.view">
        <field name="name">eurekam.maintenance.contract.line.list</field>
        <field name="model">eurekam.maintenance.contract.line</field>
        <field name="arch" type="xml">
            <list string="Yearly Lines"
                  decoration-success="is_invoiced"
                  decoration-muted="contract_state in ('cancelled','expired')"
                  editable="bottom">
                <field name="contract_id"/>
                <field name="partner_id"/>
                <!-- A year is a label, not a quantity: without this option
                     it renders "2 026". Same reason as aggregator=False on
                     the field itself. -->
                <field name="year" options="{'format': false}"/>
                <field name="amount" sum="Total"/>
                <field name="order_state" widget="badge"
                       decoration-warning="order_state == 'to_order'"
                       decoration-success="order_state == 'ordered'"
                       decoration-muted="order_state == 'not_applicable'"/>
                <field name="order_count" optional="hide"/>
                <field name="order_ids" widget="many2many_tags" optional="hide" groups="sales_team.group_sale_salesman"/>
                <field name="invoice_count" optional="show"/>
                <field name="is_invoiced" widget="boolean_toggle" readonly="1"/>
                <field name="invoice_ids" widget="many2many_tags" optional="show" groups="sales_team.group_sale_salesman"/>
                <field name="commercial_id" optional="hide"/>
                <field name="contract_state" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- There is deliberately NO standalone "inline" list view here.
         The contract form embeds its own list inside the "Yearly Amounts"
         page, so a second standalone list view would be an orphan, and a
         harmful one: with both at the default priority 16, Odoo picks by
         (priority, name, id), and "...inline.list" sorts before "...list".
         The orphan therefore won, and the "Yearly Lines" menu silently
         rendered the stripped-down view, without Contract, Establishment,
         Salesperson or Contract Status, for months (found 2026-11-24).
         test_yearly_lines_menu_shows_the_full_list guards against a relapse. -->

    <!-- ============================================================== -->
    <!-- Yearly line form view                                           -->
    <!-- ============================================================== -->
    <record id="view_maintenance_contract_line_form" model="ir.ui.view">
        <field name="name">eurekam.maintenance.contract.line.form</field>
        <field name="model">eurekam.maintenance.contract.line</field>
        <field name="arch" type="xml">
            <form string="Yearly Line">
                <sheet>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="year" options="{'format': false}"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="order_state" readonly="1"/>
                            <field name="order_count" readonly="1"/>
                            <field name="order_ids" widget="many2many_tags" readonly="1" groups="sales_team.group_sale_salesman"/>
                            <field name="is_invoiced" widget="boolean_toggle" readonly="1"/>
                            <field name="invoice_count" readonly="1"/>
                            <field name="invoice_ids" widget="many2many_tags" readonly="1" groups="sales_team.group_sale_salesman"/>
                            <field name="contract_state" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- Pivot view (analysis by year / establishment)                   -->
    <!-- ============================================================== -->
    <record id="view_maintenance_contract_line_pivot" model="ir.ui.view">
        <field name="name">eurekam.maintenance.contract.line.pivot</field>
        <field name="model">eurekam.maintenance.contract.line</field>
        <field name="arch" type="xml">
            <pivot string="Yearly Amounts Analysis">
                <field name="year" type="col"/>
                <field name="partner_id" type="row"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- Graph view                                                      -->
    <!-- ============================================================== -->
    <record id="view_maintenance_contract_line_graph" model="ir.ui.view">
        <field name="name">eurekam.maintenance.contract.line.graph</field>
        <field name="model">eurekam.maintenance.contract.line</field>
        <field name="arch" type="xml">
            <graph string="Yearly Amounts" type="bar">
                <field name="year"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- Search view                                                     -->
    <!-- ============================================================== -->
    <record id="view_maintenance_contract_line_search" model="ir.ui.view">
        <field name="name">eurekam.maintenance.contract.line.search</field>
        <field name="model">eurekam.maintenance.contract.line</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="year"/>
                <separator/>
                <!-- Years still awaiting a quotation. 'Not Applicable' lines
                     are excluded by the status itself: draft or cancelled
                     contracts, and years outside the contract period. -->
                <filter string="To Order" name="filter_to_order"
                        domain="[('order_state','=','to_order')]"/>
                <filter string="To Order - Period Started" name="filter_to_order_due"
                        domain="[('order_state','=','to_order'),('year','&lt;=', context_today().year)]"/>
                <filter string="Ordered" name="filter_ordered"
                        domain="[('order_state','=','ordered')]"/>
                <separator/>
                <filter string="Invoiced" name="filter_invoiced"
                        domain="[('is_invoiced','=',True)]"/>
                <filter string="Not Invoiced" name="filter_not_invoiced"
                        domain="[('is_invoiced','=',False)]"/>
                <filter string="Partially Invoiced" name="filter_partial"
                        domain="[('invoice_count','&gt;',0)]"/>
                <separator/>
                <filter string="Current Year" name="filter_current_year"
                        domain="[('year','=', context_today().year)]"/>
                <group expand="0" string="Group By">
                    <filter string="Year" name="group_year"
                            context="{'group_by':'year'}"/>
                    <filter string="Establishment" name="group_partner"
                            context="{'group_by':'partner_id'}"/>
                    <filter string="Contract" name="group_contract"
                            context="{'group_by':'contract_id'}"/>
                    <filter string="Ordering" name="group_order_state"
                            context="{'group_by':'order_state'}"/>
                    <filter string="Contract Status" name="group_contract_state"
                            context="{'group_by':'contract_state'}"/>
                    <filter string="Salesperson" name="group_commercial"
                            context="{'group_by':'commercial_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- Action                                                          -->
    <!-- ============================================================== -->
    <record id="action_maintenance_contract_line" model="ir.actions.act_window">
        <field name="name">Yearly Lines</field>
        <field name="res_model">eurekam.maintenance.contract.line</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_maintenance_contract_line_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No yearly line yet
            </p>
            <p>
                Yearly lines are created from a maintenance contract
                ("Generate Yearly Lines" button).
            </p>
        </field>
    </record>

</odoo>
