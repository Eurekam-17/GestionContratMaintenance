<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- QWeb PDF report action for a maintenance contract.
         binding_model_id + binding_type=report: automatically adds an entry
         to the "Print" menu of the contract view. -->
    <record id="action_report_maintenance_contract" model="ir.actions.report">
        <field name="name">Maintenance Contract Summary</field>
        <field name="model">eurekam.maintenance.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">eurekam_maintenance.report_maintenance_contract</field>
        <field name="report_file">eurekam_maintenance.report_maintenance_contract</field>
        <field name="binding_model_id" ref="model_eurekam_maintenance_contract"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

</odoo>
