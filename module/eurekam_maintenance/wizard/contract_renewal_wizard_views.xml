<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_contract_renewal_wizard_form" model="ir.ui.view">
        <field name="name">eurekam.contract.renewal.wizard.form</field>
        <field name="model">eurekam.contract.renewal.wizard</field>
        <field name="arch" type="xml">
            <form string="Renew Contract">
                <sheet>
                    <div class="oe_title">
                        <h2>Contract Renewal</h2>
                    </div>
                    <group>
                        <group string="Source Contract">
                            <field name="contract_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="old_amount" readonly="1"/>
                        </group>
                        <group string="New Contract">
                            <field name="new_date_start"/>
                            <field name="new_duration"/>
                            <field name="new_date_end"/>
                        </group>
                    </group>
                    <group>
                        <group string="Syntec Revision">
                            <field name="apply_syntec"/>
                            <field name="syntec_rate"
                                   invisible="not apply_syntec"
                                   required="apply_syntec"/>
                            <field name="syntec_delta"
                                   invisible="not apply_syntec"
                                   readonly="1"/>
                        </group>
                        <group string="Final Amount">
                            <field name="new_maintenance_amount"/>
                        </group>
                    </group>
                    <group string="Options">
                        <field name="generate_lines"/>
                        <field name="cancel_old_lines_invoiced"/>
                    </group>
                    <div class="alert alert-info mt-3" role="alert">
                        The old contract will be switched to <b>Renewed</b> and a
                        new contract will be created as <b>Active</b>, linked to
                        the previous one through the "Renewed From" / "Renewed To"
                        smart buttons.
                    </div>
                </sheet>
                <footer>
                    <button name="action_renew" type="object"
                            string="Create New Contract"
                            class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_contract_renewal_wizard" model="ir.actions.act_window">
        <field name="name">Renew Contract</field>
        <field name="res_model">eurekam.contract.renewal.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
