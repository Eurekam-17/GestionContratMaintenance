<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_maintenance_order_wizard_form" model="ir.ui.view">
        <field name="name">eurekam.maintenance.order.wizard.form</field>
        <field name="model">eurekam.maintenance.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Customer Order">
                <sheet>
                    <!-- Declared first: currency_id backs every Monetary field
                         below, and Odoo 18 requires modifier/currency fields to
                         be present before their first use. -->
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <h2>New Maintenance Customer Order</h2>
                    </div>
                    <group>
                        <group string="Source Contract">
                            <field name="contract_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                        </group>
                        <group string="Customer Purchase Order">
                            <field name="customer_po_reference"/>
                            <field name="customer_po_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Order Scope">
                            <field name="coverage_mode" widget="radio"/>
                            <field name="year"
                                   invisible="coverage_mode == 'full_contract'"
                                   required="coverage_mode == 'annual_split'"/>
                        </group>
                        <group string="Preview of What Will Be Created">
                            <field name="preview_period_count"/>
                            <field name="preview_total_amount"/>
                        </group>
                    </group>
                    <!-- Syntec revision: only for contracts flagged 'Yes',
                         and only on the per-year scope (revaluing the whole
                         contract at once is the renewal wizard's job). -->
                    <field name="syntec_revision" invisible="1"/>
                    <group string="Syntec Revision"
                           invisible="syntec_revision != 'yes' or coverage_mode != 'annual_split'">
                        <group>
                            <field name="apply_syntec"/>
                            <field name="syntec_rate" invisible="not apply_syntec"/>
                        </group>
                        <group>
                            <field name="base_amount"/>
                            <field name="revised_amount" invisible="not apply_syntec"/>
                            <field name="syntec_delta" invisible="not apply_syntec"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="not apply_syntec">
                        The revised amount will also be written onto the
                        <b>contract yearly line</b>, and the change traced in the
                        contract chatter.
                    </div>
                    <div class="alert alert-info mt-3" role="alert">
                        A <b>sale.order quotation</b> will be created as a draft with
                        the lines above. You will then be able to:
                        <ul class="mt-1 mb-0">
                            <li>Check the lines and the customer</li>
                            <li>Click <b>Confirm</b> to turn it into a sales order</li>
                            <li>Invoice each line (= each quarter/half-year/year)
                                over time via the native <b>Create Invoice</b> button</li>
                        </ul>
                    </div>
                </sheet>
                <footer>
                    <button name="action_create_sale_order" type="object"
                            string="Create Order" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_maintenance_order_wizard" model="ir.actions.act_window">
        <field name="name">Create Customer Order</field>
        <field name="res_model">eurekam.maintenance.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
